@{
    ViewData["Title"] = "Categorías";
}
<partial name="_Barra" />
<div class="card"><div class="card-body p-0 table-responsive">
    <table class="table table-hover mb-0" id="tabla">
        <thead class="table-light"><tr><th>Descripción</th><th>Estado</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
</div></div>

<div class="modal fade" id="modal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title"></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <form id="formulario">
                <input type="hidden" name="idCategoria" data-tipo="numero" />
                <div class="mb-3"><label class="form-label">Descripción</label><input name="descripcion" class="form-control" maxlength="100" required /></div>
                <div class="form-check"><input type="checkbox" name="activo" class="form-check-input" id="chkActivo" /><label class="form-check-label" for="chkActivo">Activo</label></div>
            </form>
        </div>
        <partial name="_ModalPie" />
    </div></div>
</div>

@section Scripts {
<script>
    Mantenimiento({
        base: '/Categoria', id: 'idCategoria', columnas: 3,
        nuevo: () => ({ idCategoria: 0, activo: true }),
        fila: c => `<td>${esc(c.descripcion)}</td><td>${badgeActivo(c.activo)}</td>`
    });
</script>
}
