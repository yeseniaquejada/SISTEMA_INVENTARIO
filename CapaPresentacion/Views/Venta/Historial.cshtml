@{
    ViewData["Title"] = "Historial de ventas";
}
<div class="card">
    <div class="card-header bg-white no-imprimir">
        <div class="row g-2 align-items-end">
            <div class="col-sm-2"><label class="form-label small mb-0">Desde</label><input type="date" id="txtInicio" class="form-control form-control-sm" /></div>
            <div class="col-sm-2"><label class="form-label small mb-0">Hasta</label><input type="date" id="txtFin" class="form-control form-control-sm" /></div>
            <div class="col-sm-2"><label class="form-label small mb-0">Tipo</label>
                <select id="cboTipo" class="form-select form-select-sm"><option value="">Todos</option><option value="MESA">En mesa</option><option value="LLEVAR">Para llevar</option><option value="DOMICILIO">Domicilio</option></select></div>
            <div class="col-sm-2"><button class="btn btn-sm btn-marca w-100" id="btnBuscar"><i class="bi bi-search"></i> Buscar</button></div>
            <div class="col-sm-4 text-sm-end">
                <button class="btn btn-sm btn-outline-success" id="btnExcel"><i class="bi bi-file-earmark-excel"></i> Excel</button>
                <button class="btn btn-sm btn-outline-secondary" onclick="window.print()"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
            </div>
        </div>
    </div>
    <div class="px-3 pt-2 fw-bold" id="lblTotal"></div>
    <div class="card-body p-0 table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light"><tr><th>N°</th><th>Fecha</th><th>Tipo</th><th>Cliente</th><th>Detalle</th><th>Pago</th><th>Usuario</th><th class="text-end">Total</th><th class="no-imprimir"></th></tr></thead>
            <tbody id="tablaVentas"></tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const inicio = document.getElementById('txtInicio'), fin = document.getElementById('txtFin'), tipo = document.getElementById('cboTipo');
        inicio.value = fin.value = hoy();
        async function buscar() {
            const lista = (await api.get(`/Venta/Listar?inicio=${inicio.value}&fin=${fin.value}`)).filter(v => !tipo.value || v.tipoPedido === tipo.value);
            renderTabla(document.getElementById('tablaVentas'), lista, v => `<tr class="${v.anulada ? 'text-decoration-line-through text-muted' : ''}">
                <td>${v.idVenta}</td><td class="text-nowrap">${esc(v.fecha)}</td><td>${esc(etiquetaPedido[v.tipoPedido])}</td>
                <td>${esc(v.clienteNombre)}</td><td>${esc(v.detalle)}${v.anulada ? `<br><span class="badge text-bg-danger">Anulada</span> <small>${esc(v.motivoAnulacion)}</small>` : ''}</td>
                <td>${esc(etiquetaPago[v.metodoPago])}</td>
                <td>${esc(v.usuario)}</td><td class="text-end">${moneda(v.total)}</td>
                <td class="no-imprimir text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" href="/Venta/Ticket/${v.idVenta}" target="_blank" title="Ticket"><i class="bi bi-printer"></i></a>
                    ${v.segundosEdicion > 0 ? `<a class="btn btn-sm btn-outline-primary" href="/Venta?editar=${v.idVenta}" title="Editar (quedan ${mmss(v.segundosEdicion)})"><i class="bi bi-pencil"></i></a>` : ''}
                    ${!v.anulada && v.cajaAbierta && (v.segundosEdicion > 0 || APP.esAdmin) ? `<button class="btn btn-sm btn-outline-danger" data-anular="${v.idVenta}" title="Anular"><i class="bi bi-x-circle"></i></button>` : ''}
                </td></tr>`, 9);
            const validas = lista.filter(v => !v.anulada);
            document.getElementById('lblTotal').textContent =
                `${validas.length} ventas · ${moneda(validas.reduce((s, v) => s + v.total, 0))} (${inicio.value} a ${fin.value})` +
                (validas.length < lista.length ? ` · ${lista.length - validas.length} anuladas` : '');
        }
        document.getElementById('btnBuscar').addEventListener('click', () => buscar().catch(errorAlerta));
        document.getElementById('tablaVentas').addEventListener('click', async ev => {
            const b = ev.target.closest('[data-anular]');
            if (b && await anularPedido(b.dataset.anular)) buscar().catch(errorAlerta);
        });
        document.getElementById('btnExcel').addEventListener('click', () => location.href = `/Venta/Exportar?inicio=${inicio.value}&fin=${fin.value}`);
        buscar().catch(errorAlerta);
    })();
</script>
}
