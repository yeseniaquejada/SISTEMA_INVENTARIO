@{
    ViewData["Title"] = "Qué debo comprar";
}
<div class="d-flex flex-wrap gap-2 mb-3 align-items-center no-imprimir">
    <p class="text-muted small mb-0">@* Yesenia Quejada Rojas - Claude — 31/10/2026: la cantidad se estima con lo que el negocio gasta de verdad (lo calcula SP_ORDEN_COMPRA_SUGERIDA). *@
        Insumos en el mínimo o que no alcanzan para 3 días. "A pedir" alcanza para unos 7 días; ajústelo según lo que espere vender. Los costos son aproximados.</p>
    @* Yesenia Quejada Rojas - Claude — 11/11/2026: "Imprimir tirilla" saca en la impresora térmica solo lo que está marcado, con la cantidad escrita. *@
    <div class="ms-auto d-flex gap-2">
        <button class="btn btn-sm btn-marca" id="btnTirilla" disabled><i class="bi bi-receipt"></i> Imprimir tirilla</button>
        <a href="/Compra/Exportar" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Excel</a>
        <button class="btn btn-sm btn-outline-secondary" onclick="window.print()"><i class="bi bi-file-earmark-pdf"></i> Imprimir / PDF</button>
    </div>
</div>
<p class="small text-muted no-imprimir">Desmarque lo que hoy no va a comprar. Con <i class="bi bi-x-lg"></i> el insumo sale de esta lista para siempre (sigue en el inventario y se puede volver a incluir abajo).</p>
<div id="grupos"></div>
<div class="text-end fs-5 fw-bold" id="lblTotal"></div>

@* Yesenia Quejada Rojas - Claude — 11/11/2026: insumos quitados de la lista (p. ej. la bolsa ziploc), con botón para volver a incluirlos. *@
<div class="card shadow-sm mt-3 no-imprimir" id="panelFuera" hidden>
    <div class="card-header bg-white"><strong><i class="bi bi-eye-slash"></i> Quitados de la lista de compras</strong> <small class="text-muted">no salen aunque se acaben</small></div>
    <ul class="list-group list-group-flush" id="listaFuera"></ul>
</div>

@section Scripts {
<script>
(function () {
    const $ = id => document.getElementById(id);
    let lista = [];

    async function cargar() {
        try {
            const [sugerida, fuera] = await Promise.all([api.get('/Compra/Sugerida'), api.get('/Compra/FueraDeLista')]);
            lista = sugerida;
            pintar();
            $('panelFuera').hidden = !fuera.length;
            $('listaFuera').innerHTML = fuera.map(f => `<li class="list-group-item d-flex justify-content-between align-items-center">
                <span>${esc(f.nombre)} <small class="text-muted">${esc(f.codigo)}</small></span>
                <button class="btn btn-sm btn-outline-secondary" data-incluir="${f.idInsumo}"><i class="bi bi-arrow-counterclockwise"></i> Volver a incluir</button></li>`).join('');
        } catch (e) { errorAlerta(e); }
    }

    function pintar() {
        const grupos = {};
        lista.forEach(o => (grupos[o.proveedor] ??= []).push(o));
        $('grupos').innerHTML = lista.length ? Object.entries(grupos).map(([prov, items]) => `
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white d-flex justify-content-between">
                    <strong><i class="bi bi-truck"></i> ${esc(prov)}</strong>
                    <span class="text-muted">${esc(items[0].telefonoProveedor)}</span>
                </div>
                <div class="card-body p-0 table-responsive">
                    @* Yesenia Quejada Rojas - Claude — 13/11/2026: tabla más limpia: el nombre va primero (sin código), sin "se gasta al día"
                       ni columnas de stock/mínimo/costo unitario; lo que hay y el mínimo van en pequeño bajo el nombre y el costo es aproximado. *@
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light"><tr><th>Insumo</th><th class="text-end">A pedir</th><th class="text-end">Aprox.</th><th class="no-imprimir" title="Marcado = sale en la tirilla"><i class="bi bi-check2-square"></i></th><th class="no-imprimir"></th></tr></thead>
                        <tbody>${items.map(o => `<tr data-fila="${o.idInsumo}">
                            <td><div class="fw-semibold">${esc(o.nombre)}</div><small class="text-muted">Hay ${num(Math.round(o.stock))} · mínimo ${num(o.stockMinimo)}</small></td>
                            <td class="text-end fw-bold text-nowrap"><input type="number" min="0" step="any" class="form-control form-control-sm d-inline-block text-end fw-bold" style="width:5.5rem" data-cantidad="${o.idInsumo}" value="${Number(o.cantidadSugerida)}" aria-label="Cantidad a pedir de ${esc(o.nombre)}" /> ${esc(o.unidadMedida)}</td>
                            <td class="text-end text-nowrap text-muted" data-costo="${o.idInsumo}"></td>
                            <td class="no-imprimir"><input type="checkbox" class="form-check-input" data-marcar="${o.idInsumo}" checked aria-label="Comprar ${esc(o.nombre)}" /></td>
                            <td class="no-imprimir"><button class="btn btn-sm btn-outline-danger" data-quitar="${o.idInsumo}" title="Quitar de la lista de compras" aria-label="Quitar ${esc(o.nombre)} de la lista de compras"><i class="bi bi-x-lg"></i></button></td></tr>`).join('')}</tbody>
                        <tfoot><tr><th colspan="2" class="text-end">Subtotal aprox.</th><th class="text-end text-nowrap" data-subtotal="${esc(prov)}"></th><th class="no-imprimir" colspan="2"></th></tr></tfoot>
                    </table>
                </div>
            </div>`).join('') : '<div class="alert alert-success"><i class="bi bi-check-circle"></i> No hay insumos por pedir. Todo alcanza por ahora.</div>';
        totales();
    }

    // Lo marcado con su cantidad: { idInsumo: cantidad }
    function marcados() {
        const r = {};
        lista.forEach(o => {
            const chk = document.querySelector(`[data-marcar="${o.idInsumo}"]`);
            const cant = Number(document.querySelector(`[data-cantidad="${o.idInsumo}"]`)?.value || 0);
            if (chk?.checked && cant > 0) r[o.idInsumo] = cant;
        });
        return r;
    }

    function totales() {
        const m = marcados();
        const costo = o => (m[o.idInsumo] ?? 0) * o.costoUnitario;
        // Yesenia Quejada Rojas - Claude — 13/11/2026: costos aproximados (redondeados a mil) para que la tabla se lea fácil.
        const aprox = v => v > 0 ? '≈ ' + moneda(Math.max(1000, Math.round(v / 1000) * 1000)) : '—';
        lista.forEach(o => {
            const celda = document.querySelector(`[data-costo="${o.idInsumo}"]`);
            if (celda) celda.textContent = aprox(costo(o));
            document.querySelector(`[data-fila="${o.idInsumo}"]`)?.classList.toggle('text-muted', !(o.idInsumo in m));
        });
        document.querySelectorAll('[data-subtotal]').forEach(c => c.textContent = aprox(lista.filter(o => o.proveedor === c.dataset.subtotal).reduce((s, o) => s + costo(o), 0)));
        const n = Object.keys(m).length;
        $('lblTotal').textContent = lista.length ? `${n} ${n === 1 ? 'insumo' : 'insumos'} · Total aproximado: ${aprox(lista.reduce((s, o) => s + costo(o), 0))}` : '';
        $('btnTirilla').disabled = !n;
    }
    $('grupos').addEventListener('input', totales);
    $('grupos').addEventListener('change', totales);

    $('btnTirilla').addEventListener('click', () => {
        const m = marcados();
        if (!Object.keys(m).length) { alerta('Marque al menos un insumo', 'warning'); return; }
        const f = document.createElement('form');
        f.method = 'post'; f.action = '/Compra/Tirilla'; f.target = '_blank';
        [['datos', JSON.stringify(m)], ['__RequestVerificationToken', token()]].forEach(([n, v]) => {
            const i = document.createElement('input'); i.type = 'hidden'; i.name = n; i.value = v; f.appendChild(i);
        });
        document.body.appendChild(f); f.submit(); f.remove();
    });

    $('grupos').addEventListener('click', async ev => {
        const b = ev.target.closest('[data-quitar]'); if (!b) return;
        const o = lista.find(x => x.idInsumo === Number(b.dataset.quitar));
        if (!confirm(`¿Quitar "${o?.nombre}" de la lista de compras? No volverá a salir aunque se acabe. Se puede volver a incluir abajo.`)) return;
        await cambiar(b, b.dataset.quitar, true);
    });
    $('listaFuera').addEventListener('click', async ev => {
        const b = ev.target.closest('[data-incluir]'); if (b) await cambiar(b, b.dataset.incluir, false);
    });
    async function cambiar(boton, id, fuera) {
        boton.disabled = true;
        try {
            const r = await api.post('/Compra/CambiarEnLista?' + new URLSearchParams({ idInsumo: id, fuera }));
            if (r.resultado) { alerta(fuera ? 'Quitado de la lista de compras' : 'Vuelve a salir en la lista cuando haga falta'); await cargar(); }
            else alerta(r.mensaje, 'warning');
        } catch (e) { errorAlerta(e); } finally { boton.disabled = false; }
    }

    cargar();
})();
</script>
}
