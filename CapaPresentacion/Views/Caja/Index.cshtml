@{
    ViewData["Title"] = "Caja y movimientos";
}
<div class="row g-3">
    <div class="col-lg-5">
        <!-- Caja cerrada: abrir -->
        <div class="card shadow-sm" id="panelAbrir" hidden>
            <div class="card-body">
                <h5><i class="bi bi-lock"></i> La caja está cerrada</h5>
                <p class="text-muted">Para empezar a vender, abra la caja con el dinero base que hay en el cajón.</p>
                <label class="form-label">Base inicial</label>
                <input type="number" id="txtBase" class="form-control form-control-lg mb-3" min="0" step="1000" value="0" />
                <button class="btn btn-marca w-100" id="btnAbrir"><i class="bi bi-unlock"></i> Abrir caja</button>
            </div>
        </div>

        <!-- Caja abierta: resumen y cierre -->
        <div class="card shadow-sm" id="panelCerrar" hidden>
            <div class="card-header bg-white d-flex justify-content-between">
                <strong><i class="bi bi-unlock text-success"></i> Caja abierta</strong>
                <small class="text-muted" id="lblApertura"></small>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <tr><td>Base inicial</td><td class="text-end" id="lblBase"></td></tr>
                    <tr><td>Ventas en efectivo</td><td class="text-end" id="lblEfectivo"></td></tr>
                    <tr><td>Ventas con tarjeta</td><td class="text-end" id="lblTarjeta"></td></tr>
                    <tr><td>Ventas por transferencia</td><td class="text-end" id="lblTransferencia"></td></tr>
                    <tr><td>Número de ventas</td><td class="text-end" id="lblNumero"></td></tr>
                    <tr class="text-muted small" id="filaAnuladas" hidden><td>Pedidos anulados (no suman)</td><td class="text-end" id="lblAnuladas"></td></tr>
                    <tr><td>+ Aportes de efectivo</td><td class="text-end text-success" id="lblIngresos"></td></tr>
                    <tr><td>− Compras, pagos y retiros</td><td class="text-end text-danger" id="lblEgresos"></td></tr>
                    <tr><td>Efectivo disponible ahora</td><td class="text-end" id="lblDisponible"></td></tr>
                    <tr class="fw-bold table-light"><td>Efectivo esperado en caja</td><td class="text-end" id="lblEsperado"></td></tr>
                </table>
                <div class="alert alert-warning py-2 small" id="avisoDomicilios" hidden></div>
                <div class="d-flex justify-content-between align-items-end">
                    <label class="form-label" for="txtContado">Efectivo contado</label>
                    <button type="button" class="btn btn-sm btn-link p-0 mb-2" data-bs-toggle="collapse" data-bs-target="#contador"><i class="bi bi-calculator"></i> Contar por billetes</button>
                </div>
                <div class="collapse" id="contador">
                    <div class="border rounded p-2 mb-2 bg-light">
                        <div class="row g-1 small" id="denominaciones"></div>
                        <div class="text-end fw-semibold mt-1">Total contado: <span id="lblConteoBilletes">$ 0</span></div>
                    </div>
                </div>
                <input type="number" id="txtContado" class="form-control form-control-lg" min="0" step="100" />
                <div class="my-2 fw-semibold" id="lblDiferencia"></div>
                <input id="txtObservacion" class="form-control mb-3" maxlength="250" placeholder="Observación (opcional)" />
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-secondary" id="lnkPrevia" target="_blank" title="Ver el reporte antes de cerrar"><i class="bi bi-eye"></i> Vista previa</a>
                    <button class="btn btn-marca flex-grow-1" id="btnCerrar"><i class="bi bi-lock"></i> Cerrar caja</button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm mb-3" id="panelMovimiento" hidden>
            <div class="card-header bg-white"><strong><i class="bi bi-arrow-left-right"></i> Registrar dinero que entra o sale</strong></div>
            <div class="card-body">
                <p class="small text-muted">Registre compras pequeñas, pagos y retiros del dueño. Una compra aquí registra el dinero; los insumos se ingresan por Inventario → Entradas.</p>
                <form id="formMovimiento" class="row g-3">
                    <div class="col-sm-6"><label for="tipoMovimiento" class="form-label">Tipo</label><select id="tipoMovimiento" name="tipo" class="form-select"><option value="COMPRA">Compra pequeña</option><option value="PAGO">Pago / gasto</option>@if(User.IsInRole("ADMINISTRADOR")){<option value="RETIRO">Retiro del dueño</option>}<option value="INGRESO">Aporte de efectivo</option></select></div>
                    <div class="col-sm-6"><label for="medioMovimiento" class="form-label">Medio de pago</label><select id="medioMovimiento" name="metodoPago" class="form-select"><option value="EFECTIVO">Efectivo de la caja</option><option value="TRANSFERENCIA">Transferencia</option><option value="TARJETA">Tarjeta</option></select></div>
                    <div class="col-sm-6"><label for="montoMovimiento" class="form-label">Monto</label><input id="montoMovimiento" name="monto" type="number" min="0.01" max="9999999999.99" step="0.01" class="form-control" data-tipo="numero" required /></div>
                    <div class="col-sm-6"><label for="beneficiarioMovimiento" class="form-label">Pagado a / recibido de</label><input id="beneficiarioMovimiento" name="beneficiario" maxlength="100" class="form-control" /></div>
                    <div class="col-12"><label for="conceptoMovimiento" class="form-label">Concepto</label><input id="conceptoMovimiento" name="concepto" maxlength="250" class="form-control" placeholder="Ej.: compra de bolsas, pago transporte, retiro del dueño" required /></div>
                    <div class="col-12 d-flex align-items-center gap-3"><button class="btn btn-marca" id="btnMovimiento">Guardar movimiento</button><small class="text-muted">Tarjeta y transferencia no descuentan efectivo del cajón.</small></div>
                </form>
            </div>
            <div class="table-responsive"><table class="table table-sm mb-0"><thead class="table-light"><tr><th>Fecha / usuario</th><th>Concepto</th><th>Medio</th><th class="text-end">Monto</th><th></th></tr></thead><tbody id="tablaMovimientos"></tbody></table></div>
        </div>
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <strong>Cierres anteriores</strong>
                <button class="btn btn-sm btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Imprimir</button>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light"><tr><th>Apertura</th><th>Cierre</th><th class="text-end">Efectivo</th><th class="text-end">Tarjeta</th><th class="text-end">Transf.</th><th class="text-end">Esperado</th><th class="text-end">Contado</th><th class="text-end">Diferencia</th><th>Cerró</th><th class="no-imprimir"></th></tr></thead>
                    <tbody id="tablaHistorial"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const $ = id => document.getElementById(id);
    let esperado = 0, referencia = crypto.randomUUID();
    const DENOMINACIONES = [100000, 50000, 20000, 10000, 5000, 2000, 1000, 500, 200, 100, 50];
    $('denominaciones').innerHTML = DENOMINACIONES.map(d => `
        <div class="col-6 d-flex align-items-center gap-1">
            <span class="text-end text-nowrap" style="min-width:5.5rem">${moneda(d)}</span><span>×</span>
            <input type="number" min="0" step="1" class="form-control form-control-sm" data-den="${d}" placeholder="0" />
        </div>`).join('');
    $('denominaciones').addEventListener('input', () => {
        const t = [...$('denominaciones').querySelectorAll('[data-den]')].reduce((s, i) => s + Number(i.dataset.den) * Math.max(0, Number(i.value || 0)), 0);
        $('lblConteoBilletes').textContent = moneda(t);
        $('txtContado').value = t;
        diferencia();
    });

    async function cargar() {
        try {
            const [c, historial] = await Promise.all([api.get('/Caja/Actual'), api.get('/Caja/Historial')]);
            $('panelAbrir').hidden = !!c;
            $('panelCerrar').hidden = !c;
            $('panelMovimiento').hidden = !c;
            if (c) {
                esperado = c.baseInicial + c.ventasEfectivo + c.ingresosEfectivo - c.egresosEfectivo;
                $('lblIngresos').textContent=moneda(c.ingresosEfectivo);
                $('lblEgresos').textContent=moneda(c.egresosEfectivo);
                $('lblDisponible').textContent=moneda(esperado-c.efectivoEnDomicilios);
                $('btnCerrar').disabled=c.efectivoEnDomicilios>0;
                await movimientos(c.idCaja);
                $('lblApertura').textContent = `${c.fechaApertura} · ${c.usuarioApertura}`;
                $('lblBase').textContent = moneda(c.baseInicial);
                $('lblEfectivo').textContent = moneda(c.ventasEfectivo);
                $('lblTarjeta').textContent = moneda(c.ventasTarjeta);
                $('lblTransferencia').textContent = moneda(c.ventasTransferencia);
                $('lblNumero').textContent = c.numeroVentas;
                $('filaAnuladas').hidden = !c.numeroAnuladas;
                $('lblAnuladas').textContent = `${c.numeroAnuladas} · ${moneda(c.totalAnulado)}`;
                $('lblEsperado').textContent = moneda(esperado);
                $('avisoDomicilios').hidden = !c.efectivoEnDomicilios;
                $('avisoDomicilios').innerHTML = `<i class="bi bi-bicycle"></i> Hay ${moneda(c.efectivoEnDomicilios)} de domicilios en efectivo que aún no se han entregado. Ese dinero está incluido en el esperado. Registre la entrega al recuperar el efectivo; el cierre permanece bloqueado mientras esté pendiente.`;
                $('lnkPrevia').href = `/Caja/Reporte/${c.idCaja}?vista=1`;
                diferencia();
            }
            renderTabla($('tablaHistorial'), historial, h => `<tr>
                <td class="text-nowrap">${esc(h.fechaApertura)}</td><td class="text-nowrap">${esc(h.fechaCierre)}</td>
                <td class="text-end">${moneda(h.ventasEfectivo)}</td><td class="text-end">${moneda(h.ventasTarjeta)}</td>
                <td class="text-end">${moneda(h.ventasTransferencia)}</td><td class="text-end">${moneda(h.efectivoEsperado)}</td>
                <td class="text-end">${moneda(h.efectivoContado)}</td>
                <td class="text-end ${h.diferencia < 0 ? 'text-danger' : h.diferencia > 0 ? 'text-primary' : 'text-success'}">${moneda(h.diferencia)}</td>
                <td>${esc(h.usuarioCierre)}${h.observacion ? `<br><small class="text-muted">${esc(h.observacion)}</small>` : ''}</td>
                <td class="no-imprimir"><a class="btn btn-sm btn-outline-secondary" href="/Caja/Reporte/${h.idCaja}" target="_blank" title="Reporte de cierre"><i class="bi bi-printer"></i></a></td></tr>`, 10);
        } catch (e) { errorAlerta(e); }
    }

    async function movimientos(idCaja) {
        const lista = await api.get('/Caja/Movimientos?idCaja='+idCaja);
        renderTabla($('tablaMovimientos'),lista,m=>`<tr class="${m.anulado?'text-muted':''}"><td><small>${esc(m.fecha)}<br>${esc(m.usuario)}</small></td><td><span class="badge text-bg-light">${esc(m.tipo)}</span> ${esc(m.concepto)}<small class="d-block">${esc(m.beneficiario)}${m.anulado?' · ANULADO: '+esc(m.motivoAnulacion):''}</small></td><td>${esc(m.metodoPago)}</td><td class="text-end text-nowrap">${m.tipo==='INGRESO'?'+':'−'} ${moneda(m.monto)}</td><td>${APP.esAdmin&&!m.anulado?'<button class="btn btn-sm btn-outline-danger" data-anular-mov="'+m.idMovimientoCaja+'">Anular</button>':''}</td></tr>`,5);
    }
    $('tipoMovimiento').addEventListener('change',()=>{
        const efectivo=['INGRESO','RETIRO'].includes($('tipoMovimiento').value);
        $('medioMovimiento').disabled=efectivo;
        if(efectivo) $('medioMovimiento').value='EFECTIVO';
    });
    $('formMovimiento').addEventListener('submit',async ev=>{
        ev.preventDefault(); if(!$('formMovimiento').reportValidity()) return;
        $('btnMovimiento').disabled=true;
        try {
            const datos=leerForm($('formMovimiento')); datos.referencia=referencia;
            const r=await api.post('/Caja/RegistrarMovimiento',datos);
            if(r.resultado){ referencia=crypto.randomUUID(); $('formMovimiento').reset(); $('medioMovimiento').disabled=false; alerta('Movimiento registrado'); await cargar(); }
            else alerta(r.mensaje,'warning');
        } catch(e){errorAlerta(e);} finally{$('btnMovimiento').disabled=false;}
    });
    $('tablaMovimientos').addEventListener('click',async ev=>{
        const b=ev.target.closest('[data-anular-mov]'); if(!b)return;
        const motivo=prompt('Motivo de anulación (el dinero debe haber sido devuelto o corregido):'); if(!motivo?.trim())return;
        b.disabled=true;
        try{const q=new URLSearchParams({id:b.dataset.anularMov,motivo}); const r=await api.post('/Caja/AnularMovimiento?'+q); if(r.resultado){alerta('Movimiento anulado');await cargar();}else alerta(r.mensaje,'warning');}catch(e){errorAlerta(e);}finally{b.disabled=false;}
    });
    function diferencia() {
        const v = $('txtContado').value;
        if (v === '') { $('lblDiferencia').textContent = ''; return; }
        const d = Number(v) - esperado;
        $('lblDiferencia').className = 'my-2 fw-semibold ' + (d < 0 ? 'text-danger' : d > 0 ? 'text-primary' : 'text-success');
        $('lblDiferencia').textContent = d === 0 ? 'La caja cuadra exacto' : d < 0 ? `Faltan ${moneda(-d)}` : `Sobran ${moneda(d)}`;
    }
    $('txtContado').addEventListener('input', diferencia);

    $('btnAbrir').addEventListener('click', async () => {
        try {
            const r = await api.post(`/Caja/Abrir?baseInicial=${Number($('txtBase').value || 0)}`);
            if (r.resultado) { alerta('Caja abierta'); cargar(); } else alerta(r.mensaje, 'warning');
        } catch (e) { errorAlerta(e); }
    });

    $('btnCerrar').addEventListener('click', async () => {
        const anterior=esperado; await cargar(); if(esperado!==anterior){alerta('Hubo movimientos nuevos. Revise el saldo antes de cerrar.','warning');return;}
        if ($('btnCerrar').disabled) return;
        if ($('txtContado').value === '') { alerta('Ingrese el efectivo contado', 'warning'); return; }
        if (!confirm('¿Cerrar la caja? Después no se podrán registrar ventas hasta abrirla de nuevo.')) return;
        const reporte = window.open('', '_blank');   // se abre ya para que el navegador no la bloquee
        try {
            const q = new URLSearchParams({ efectivoContado: $('txtContado').value, observacion: $('txtObservacion').value });
            const r = await api.post(`/Caja/Cerrar?${q}`);
            if (r.resultado) {
                alerta('Caja cerrada');
                if (reporte) reporte.location = `/Caja/Reporte/${r.id}`;
                $('txtContado').value = ''; $('txtObservacion').value = '';
                $('denominaciones').querySelectorAll('input').forEach(i => i.value = '');
                cargar();
            }
            else { reporte?.close(); alerta(r.mensaje, 'warning'); }
        } catch (e) { reporte?.close(); errorAlerta(e); }
    });

    cargar();
})();
</script>
}
