@{
    ViewData["Title"] = "Proveedores";
}
<partial name="_Barra" />
<div class="card"><div class="card-body p-0 table-responsive">
    <table class="table table-hover mb-0" id="tabla">
        <thead class="table-light"><tr><th>Documento</th><th>Razón social</th><th>Teléfono</th><th>Correo</th><th>Estado</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
</div></div>

<div class="modal fade" id="modal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title"></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <form id="formulario" class="row g-3">
                <input type="hidden" name="idProveedor" data-tipo="numero" />
                <div class="col-md-5"><label class="form-label">Documento (NIT)</label><input name="documento" class="form-control" maxlength="20" required /></div>
                <div class="col-md-7"><label class="form-label">Razón social</label><input name="razonSocial" class="form-control" maxlength="150" required /></div>
                <div class="col-md-5"><label class="form-label">Teléfono</label><input name="telefono" class="form-control" maxlength="30" /></div>
                <div class="col-md-7"><label class="form-label">Correo</label><input name="correo" type="email" class="form-control" maxlength="100" /></div>
                <div class="col-12 form-check ms-2"><input type="checkbox" name="activo" class="form-check-input" id="chkActivo" /><label class="form-check-label" for="chkActivo">Activo</label></div>
            </form>
        </div>
        <partial name="_ModalPie" />
    </div></div>
</div>

@section Scripts {
<script>
    Mantenimiento({
        base: '/Proveedor', id: 'idProveedor', columnas: 6,
        nuevo: () => ({ idProveedor: 0, activo: true }),
        fila: p => `<td>${esc(p.documento)}</td><td>${esc(p.razonSocial)}</td><td>${esc(p.telefono)}</td>
                    <td>${esc(p.correo)}</td><td>${badgeActivo(p.activo)}</td>`
    });
</script>
}
