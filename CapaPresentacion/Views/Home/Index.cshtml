@{
    ViewData["Title"] = "Panel de control";
}
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="card tarjeta border-start border-danger border-4"><div class="card-body"><div class="text-muted small">Ventas de hoy</div><div class="fs-4 fw-bold" id="kpiVentas">-</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card tarjeta border-start border-primary border-4"><div class="card-body"><div class="text-muted small">Pedidos de hoy</div><div class="fs-4 fw-bold" id="kpiPedidos">-</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card tarjeta border-start border-success border-4"><div class="card-body"><div class="text-muted small">Valor del inventario</div><div class="fs-4 fw-bold" id="kpiValor">-</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card tarjeta border-start border-warning border-4"><div class="card-body"><div class="text-muted small">Insumos bajo mínimo</div><div class="fs-4 fw-bold" id="kpiBajo">-</div></div></div></div>
</div>

<div class="card">
    <div class="card-header bg-white fw-semibold"><i class="bi bi-exclamation-triangle text-warning"></i> Insumos por reabastecer</div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Código</th><th>Insumo</th><th class="text-end">Stock</th><th class="text-end">Mínimo</th></tr></thead>
            <tbody id="tablaAlertas"><tr><td colspan="4" class="text-center text-muted">Cargando...</td></tr></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
