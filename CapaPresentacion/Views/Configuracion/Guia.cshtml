@model CapaEntidad.Configuracion
@{
    ViewData["Title"] = "Guía de configuración";
    int insumos = ViewBag.Insumos, categorias = ViewBag.Categorias, productos = ViewBag.Productos,
        sinReceta = ViewBag.SinReceta, adiciones = ViewBag.Adiciones, usuarios = ViewBag.Usuarios;
    bool negocio = ViewBag.Negocio, cajaAbierta = ViewBag.CajaAbierta;
    var pasos = new (bool listo, string titulo, string detalle, string estado, string controlador, string accion)[]
    {
        (negocio, "Datos del negocio", "Nombre, teléfono, logo y colores. Es lo que sale en el ticket y en la pantalla.",
            negocio ? "Listo" : "Falta el nombre o el teléfono", "Configuracion", "Index"),
        (insumos > 0, "Insumos (lo que compra)", "Pan, carne, queso, gaseosas... Lo más rápido: descargue la plantilla de Excel, llénela con lo que hay hoy y súbala.",
            insumos > 0 ? $"{insumos} insumos" : "Aún no hay insumos", "Insumo", "Index"),
        (categorias > 0, "Categorías del menú", "Cómo se agrupan los productos al vender: hamburguesas, perros, bebidas...",
            categorias > 0 ? $"{categorias} categorías" : "Aún no hay categorías", "CategoriaMenu", "Index"),
        (productos > 0 && sinReceta == 0, "Productos y recetas", "Cada producto con su precio, foto y receta. La receta dice qué insumos se descuentan al venderlo.",
            productos == 0 ? "Aún no hay productos" : sinReceta > 0 ? $"{productos} productos · {sinReceta} sin receta" : $"{productos} productos con receta", "Producto", "Index"),
        (adiciones > 0, "Adiciones y salsas", "Lo que el cliente puede agregar (extra queso, salsas). Para quitar ingredientes no hace falta crear nada.",
            adiciones > 0 ? $"{adiciones} opciones" : "Opcional", "Modificador", "Index"),
        (usuarios > 1, "Usuarios", "Quién entra al sistema: administrador, cajero (vende y cocina) y domiciliario.",
            $"{usuarios} usuarios", "Usuario", "Index"),
        (cajaAbierta, "Abrir la caja y vender", "Cada día: abra la caja con la base, venda y al final cierre la caja contando el efectivo.",
            cajaAbierta ? "Caja abierta" : "Caja cerrada", "Caja", "Index"),
    };
    var hechos = pasos.Count(p => p.listo);
}
@* Yesenia Quejada Rojas - Claude — 19/10/2026: guía paso a paso para dejar el sistema listo, en el orden en que se necesita. *@
<p class="text-muted">Siga los pasos en orden. Cuando un paso está listo se marca en verde. Llevan <b>@hechos de @pasos.Length</b>.</p>
<div class="progress mb-4" style="height:8px" role="progressbar" aria-label="Avance de la configuración" aria-valuenow="@hechos" aria-valuemin="0" aria-valuemax="@pasos.Length">
    <div class="progress-bar bg-success" style="width:@(hechos * 100 / pasos.Length)%"></div>
</div>
<div class="d-grid gap-2" style="max-width:820px">
    @for (int i = 0; i < pasos.Length; i++)
    {
        var p = pasos[i];
        <a class="guia-paso @(p.listo ? "listo" : "")" asp-controller="@p.controlador" asp-action="@p.accion">
            <span class="paso-menu">@if (p.listo) { <i class="bi bi-check-lg"></i> } else { @(i + 1) }</span>
            <span class="flex-grow-1">
                <span class="d-flex justify-content-between flex-wrap gap-2">
                    <strong>@p.titulo</strong>
                    <small class="@(p.listo ? "text-success" : "text-muted")">@p.estado</small>
                </span>
                <small class="d-block text-muted">@p.detalle</small>
            </span>
            <i class="bi bi-chevron-right text-muted align-self-center"></i>
        </a>
    }
</div>
<div class="card mt-4" style="max-width:820px"><div class="card-body small">
    <strong><i class="bi bi-lightbulb"></i> En el día a día</strong>
    <ul class="mb-0 mt-2">
        <li>Las ventas descuentan los insumos solas, según la receta de cada producto.</li>
        <li>Cuando llegue una compra o algo se dañe: <a asp-controller="Movimiento" asp-action="Index">Registrar compras y salidas</a>.</li>
        <li>Si cuenta el local y no coincide: suba la plantilla de insumos con lo que contó, o use <a asp-controller="Conteo" asp-action="Index">Contar inventario</a>.</li>
    </ul>
</div></div>
