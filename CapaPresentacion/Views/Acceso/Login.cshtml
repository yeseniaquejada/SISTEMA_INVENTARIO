@using CapaPresentacion.Infraestructura
@model CapaEntidad.Configuracion
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión - @Model.NombreNegocio</title>
    @if (!string.IsNullOrEmpty(Model.LogoUrl)) { <link rel="icon" href="@Model.LogoUrl" /> }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --marca: @Model.ColorPrimario;
            --marca-texto: @Colores.TextoSobre(Model.ColorPrimario);
            --marca-2: @Model.ColorSecundario;
            --marca-2-texto: @Colores.TextoSobre(Model.ColorSecundario);
        }
    </style>
</head>
<body class="login-fondo d-flex align-items-center justify-content-center p-3">
    <div class="card shadow-lg login-card border-0">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                @if (!string.IsNullOrEmpty(Model.LogoUrl)) { <img src="@Model.LogoUrl" alt="" class="login-logo" /> }
                else { <i class="bi bi-basket2-fill text-marca display-4"></i> }
                <h4 class="mt-2 fw-bold">@Model.NombreNegocio</h4>
                <p class="text-muted small">Ingrese sus credenciales</p>
            </div>
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }
            <form method="post" asp-action="Login" asp-route-returnUrl="@Context.Request.Query["ReturnUrl"]">
                <div class="mb-3">
                    <label class="form-label">Usuario</label>
                    <input name="usuario" class="form-control" required autofocus />
                </div>
                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <input name="clave" type="password" class="form-control" required />
                </div>
                <button class="btn btn-marca w-100 btn-lg">Ingresar</button>
            </form>
        </div>
    </div>
</body>
</html>
