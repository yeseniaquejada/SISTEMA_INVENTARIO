@{
    ViewData["Title"] = "Reportes de ventas y ganancias";
}
<div class="card shadow-sm mb-3 no-imprimir">
    <div class="card-body d-flex flex-wrap gap-2 align-items-end">
        <div><label class="form-label small mb-0">Desde</label><input type="date" id="txtInicio" class="form-control form-control-sm" /></div>
        <div><label class="form-label small mb-0">Hasta</label><input type="date" id="txtFin" class="form-control form-control-sm" /></div>
        <div class="btn-group btn-group-sm" id="rapidos">
            <button class="btn btn-outline-secondary" data-dias="0">Hoy</button>
            <button class="btn btn-outline-secondary" data-dias="6">7 días</button>
            <button class="btn btn-outline-secondary" data-dias="29">30 días</button>
        </div>
        <button class="btn btn-sm btn-marca" id="btnVer"><i class="bi bi-bar-chart"></i> Ver</button>
        <button class="btn btn-sm btn-outline-secondary ms-auto" onclick="window.print()"><i class="bi bi-file-earmark-pdf"></i> Imprimir / PDF</button>
    </div>
</div>
<p class="d-none d-print-block" id="lblPeriodo"></p>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-2"><div class="card kpi shadow-sm"><div class="card-body"><div class="small text-muted">Ventas</div><div class="valor" id="kVentas"></div></div></div></div>
    <div class="col-6 col-lg-2"><div class="card kpi shadow-sm"><div class="card-body"><div class="small text-muted">Pedidos</div><div class="valor" id="kPedidos"></div></div></div></div>
    <div class="col-6 col-lg-2"><div class="card kpi shadow-sm"><div class="card-body"><div class="small text-muted">Ticket promedio</div><div class="valor" id="kTicket"></div></div></div></div>
    <div class="col-6 col-lg-2"><div class="card kpi alerta shadow-sm"><div class="card-body"><div class="small text-muted">Costo de insumos</div><div class="valor" id="kCosto"></div></div></div></div>
    <div class="col-6 col-lg-2"><div class="card kpi ok shadow-sm"><div class="card-body"><div class="small text-muted">Ganancia bruta</div><div class="valor" id="kGanancia"></div></div></div></div>
    <div class="col-6 col-lg-2"><div class="card kpi alerta shadow-sm"><div class="card-body"><div class="small text-muted">Mermas</div><div class="valor" id="kMermas"></div></div></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-8"><div class="card shadow-sm"><div class="card-header bg-white"><strong>Ventas por día</strong></div><div class="card-body"><canvas id="grDias" height="120"></canvas></div></div></div>
    <div class="col-lg-4"><div class="card shadow-sm"><div class="card-header bg-white"><strong>Formas de pago</strong></div><div class="card-body"><canvas id="grMetodos" height="220"></canvas></div></div></div>
    <div class="col-lg-7"><div class="card shadow-sm"><div class="card-header bg-white"><strong>Productos más vendidos</strong></div><div class="card-body"><canvas id="grTop" height="170"></canvas></div></div></div>
    <div class="col-lg-5"><div class="card shadow-sm"><div class="card-header bg-white"><strong>Detalle de productos</strong></div>
        <div class="card-body p-0 table-responsive"><table class="table table-sm mb-0">
            <thead class="table-light"><tr><th>Producto</th><th class="text-end">Unidades</th><th class="text-end">Total</th></tr></thead>
            <tbody id="tablaTop"></tbody></table></div></div></div>
</div>

@section Scripts {
<script src="~/lib/chartjs/chart.umd.min.js"></script>
<script>
(function () {
    const $ = id => document.getElementById(id);
    const marca = getComputedStyle(document.documentElement).getPropertyValue('--marca').trim() || '#C8322B';
    const marca2 = getComputedStyle(document.documentElement).getPropertyValue('--marca-2').trim() || '#1F1A17';
    const graficas = {};

    function grafica(id, config) {
        graficas[id]?.destroy();
        graficas[id] = new Chart($(id), config);
    }

    async function ver() {
        try {
            const r = await api.get(`/Reporte/Datos?inicio=${$('txtInicio').value}&fin=${$('txtFin').value}`);
            $('lblPeriodo').textContent = `Periodo: ${$('txtInicio').value} a ${$('txtFin').value}`;
            $('kVentas').textContent = moneda(r.ventas);
            $('kPedidos').textContent = r.pedidos;
            $('kTicket').textContent = moneda(r.ticketPromedio);
            $('kCosto').textContent = moneda(r.costoInsumos);
            $('kGanancia').textContent = moneda(r.ganancia);
            $('kMermas').textContent = moneda(r.mermas);

            grafica('grDias', {
                type: 'bar',
                data: { labels: r.porDia.map(p => p.etiqueta), datasets: [{ label: 'Ventas', data: r.porDia.map(p => p.total), backgroundColor: marca, borderRadius: 6 }] },
                options: { plugins: { legend: { display: false } }, scales: { y: { ticks: { callback: v => moneda(v) } } } }
            });
            grafica('grMetodos', {
                type: 'doughnut',
                data: { labels: r.porMetodo.map(p => etiquetaPago[p.etiqueta] ?? p.etiqueta), datasets: [{ data: r.porMetodo.map(p => p.total), backgroundColor: [marca, marca2, '#f0ad00'] }] },
                options: { plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: c => `${c.label}: ${moneda(c.raw)}` } } } }
            });
            grafica('grTop', {
                type: 'bar',
                data: { labels: r.topProductos.map(p => p.etiqueta), datasets: [{ label: 'Unidades', data: r.topProductos.map(p => p.cantidad), backgroundColor: marca2, borderRadius: 6 }] },
                options: { indexAxis: 'y', plugins: { legend: { display: false } } }
            });
            renderTabla($('tablaTop'), r.topProductos, p => `<tr><td>${esc(p.etiqueta)}</td><td class="text-end">${p.cantidad}</td><td class="text-end">${moneda(p.total)}</td></tr>`, 3);
        } catch (e) { errorAlerta(e); }
    }

    function rango(dias) { $('txtInicio').value = fechaHace(dias); $('txtFin').value = hoy(); ver(); }
    $('rapidos').addEventListener('click', ev => { const b = ev.target.closest('[data-dias]'); if (b) rango(Number(b.dataset.dias)); });
    $('btnVer').addEventListener('click', ver);
    rango(6);
})();
</script>
}
