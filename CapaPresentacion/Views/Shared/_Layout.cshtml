@{
    var esAdmin = User.IsInRole("ADMINISTRADOR");
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    string Activo(string c) => controlador == c ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventario Comidas Rápidas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-danger shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><i class="bi bi-basket2-fill"></i> Inventario Fast Food</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link @Activo("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Inicio</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @Activo("Venta")" href="#" data-bs-toggle="dropdown"><i class="bi bi-cart"></i> Ventas</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Venta" asp-action="Index">Nueva venta</a></li>
                            <li><a class="dropdown-item" asp-controller="Venta" asp-action="Historial">Historial</a></li>
                        </ul>
                    </li>
                    @if (esAdmin)
                    {
                        <li class="nav-item"><a class="nav-link @Activo("Movimiento")" asp-controller="Movimiento" asp-action="Index"><i class="bi bi-arrow-left-right"></i> Movimientos</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-gear"></i> Mantenimiento</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Insumo" asp-action="Index">Insumos</a></li>
                                <li><a class="dropdown-item" asp-controller="Producto" asp-action="Index">Productos del menú</a></li>
                                <li><a class="dropdown-item" asp-controller="Categoria" asp-action="Index">Categorías</a></li>
                                <li><a class="dropdown-item" asp-controller="Proveedor" asp-action="Index">Proveedores</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <span class="navbar-text text-white me-3"><i class="bi bi-person-circle"></i> @User.Identity?.Name</span>
                <form asp-controller="Acceso" asp-action="Salir" method="post" class="d-inline">
                    <button class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Salir</button>
                </form>
            </div>
        </div>
    </nav>

    @Html.AntiForgeryToken()
    <main class="container-fluid py-4 px-md-4">
        <h4 class="mb-3">@ViewData["Title"]</h4>
        @RenderBody()
    </main>

    <div class="toast-container position-fixed top-0 end-0 p-3" id="contenedorAlertas"></div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
