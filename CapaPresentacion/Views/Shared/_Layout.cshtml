@using CapaPresentacion.Infraestructura
@{
    var cfg = new CapaNegocio.CN_Configuracion().Obtener();
    var esAdmin = User.IsInRole(Claves.Admin);
    var esDomiciliario = User.IsInRole(Claves.Domiciliario);
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    string Activo(params string[] c) => c.Contains(controlador) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="~/js/tema.js" asp-append-version="true"></script>
    <title>@ViewData["Title"] - @cfg.NombreNegocio</title>
    @if (!string.IsNullOrEmpty(cfg.LogoUrl)) { <link rel="icon" href="@cfg.LogoUrl" /> }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
    <style>
        :root {
            --marca: @cfg.ColorPrimario;
            --marca-texto: @Colores.TextoSobre(cfg.ColorPrimario);
            --marca-2: @cfg.ColorSecundario;
            --marca-2-texto: @Colores.TextoSobre(cfg.ColorSecundario);
        }
    </style>
</head>
<body class="app-shell">
    <nav class="navbar navbar-expand-xl navbar-dark barra-marca shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-controller="Home" asp-action="Index">
                @if (!string.IsNullOrEmpty(cfg.LogoUrl)) { <img src="@cfg.LogoUrl" alt="" class="logo-nav" /> }
                else { <span class="brand-symbol"><i class="bi bi-basket2-fill"></i></span> }
                <span>@cfg.NombreNegocio</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span><span class="visually-hidden">Abrir menú</span></button>
            <div class="collapse navbar-collapse" id="menu">
                @* Yesenia Quejada Rojas - Claude — 19/10/2026: menú por perfil. "Mantenimiento" pasa a "Configuración" con los pasos en orden
                   y el inventario adentro; el domiciliario solo ve sus domicilios. *@
                <ul class="navbar-nav me-auto">
                    @if (esDomiciliario)
                    {
                        <li class="nav-item"><a class="nav-link @Activo("Domicilio")" asp-controller="Domicilio" asp-action="Index"><i class="bi bi-bicycle"></i> Mis domicilios</a></li>
                    }
                    else
                    {
                    <li class="nav-item"><a class="nav-link @Activo("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Inicio</a></li>
                    <li class="nav-item"><a class="nav-link @Activo("Venta")" asp-controller="Venta" asp-action="Index"><i class="bi bi-cart3"></i> Vender</a></li>
                    @if(cfg.MostrarCocina){ <li class="nav-item"><a class="nav-link @Activo("Cocina")" asp-controller="Cocina" asp-action="Index"><i class="bi bi-fire"></i> Cocina</a></li> }
                    @if(cfg.MostrarDomicilios){ <li class="nav-item"><a class="nav-link @Activo("Domicilio")" asp-controller="Domicilio" asp-action="Index"><i class="bi bi-bicycle"></i> Domicilios</a></li> }
                    <li class="nav-item"><a class="nav-link @Activo("Caja")" asp-controller="Caja" asp-action="Index"><i class="bi bi-cash-stack"></i> Caja</a></li>
                    @if (esAdmin)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @Activo("Reporte")" href="#" data-bs-toggle="dropdown"><i class="bi bi-graph-up"></i> Reportes</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Reporte" asp-action="Index"><i class="bi bi-bar-chart"></i> Ventas y ganancias</a></li>
                                <li><a class="dropdown-item" asp-controller="Venta" asp-action="Historial"><i class="bi bi-receipt"></i> Historial de ventas</a></li>
                                <li><a class="dropdown-item" asp-controller="Reporte" asp-action="Actividad"><i class="bi bi-clock-history"></i> Quién hizo qué</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @Activo("Producto", "Modificador", "CategoriaMenu", "Proveedor", "Usuario", "Sede", "Configuracion", "Insumo", "Movimiento", "Conteo", "Compra")" href="#" data-bs-toggle="dropdown"><i class="bi bi-gear"></i> Configuración</a>
                            <ul class="dropdown-menu menu-config">
                                <li><a class="dropdown-item fw-semibold" asp-controller="Configuracion" asp-action="Guia"><i class="bi bi-signpost-split"></i> Guía: por dónde empezar</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><h6 class="dropdown-header">Primero, en este orden</h6></li>
                                <li><a class="dropdown-item" asp-controller="Configuracion" asp-action="Index"><span class="paso-menu">1</span> Datos del negocio</a></li>
                                <li><a class="dropdown-item" asp-controller="Insumo" asp-action="Index"><span class="paso-menu">2</span> Insumos (lo que compras)</a></li>
                                <li><a class="dropdown-item" asp-controller="CategoriaMenu" asp-action="Index"><span class="paso-menu">3</span> Categorías del menú</a></li>
                                <li><a class="dropdown-item" asp-controller="Producto" asp-action="Index"><span class="paso-menu">4</span> Productos y recetas</a></li>
                                <li><a class="dropdown-item" asp-controller="Modificador" asp-action="Index"><span class="paso-menu">5</span> Adiciones y salsas</a></li>
                                <li><a class="dropdown-item" asp-controller="Usuario" asp-action="Index"><span class="paso-menu">6</span> Usuarios</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><h6 class="dropdown-header">Inventario del día a día</h6></li>
                                <li><a class="dropdown-item" asp-controller="Movimiento" asp-action="Index"><i class="bi bi-box-arrow-in-down"></i> Registrar compras y salidas</a></li>
                                @if(cfg.MostrarAvanzado){ <li><a class="dropdown-item" asp-controller="Conteo" asp-action="Index"><i class="bi bi-clipboard-check"></i> Contar inventario</a></li> }
                                @if(cfg.MostrarAvanzado){ <li><a class="dropdown-item" asp-controller="Compra" asp-action="Index"><i class="bi bi-cart-check"></i> Qué debo comprar</a></li> }
                                <li><a class="dropdown-item" asp-controller="Proveedor" asp-action="Index"><i class="bi bi-truck"></i> Proveedores</a></li>
                                @if(cfg.MostrarMultisede){ <li><a class="dropdown-item" asp-controller="Sede" asp-action="Index"><i class="bi bi-shop"></i> Sedes</a></li> }
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @Activo("Venta")" asp-controller="Venta" asp-action="Historial"><i class="bi bi-receipt"></i> Mis ventas</a></li>
                    }
                    }
                </ul>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <partial name="_SelectorTema" />
                    @if (esAdmin && cfg.MostrarMultisede)
                    {
                        <form asp-controller="Acceso" asp-action="CambiarSede" method="post" id="formSede" class="d-flex">
                            <input type="hidden" name="volver" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            <select name="idSede" id="cboSedeNav" class="form-select form-select-sm" data-actual="@User.IdSede()" title="Sede">
                                <option value="@User.IdSede()">@User.Sede()</option>
                            </select>
                        </form>
                    }
                    else if (cfg.MostrarMultisede)
                    {
                        <span class="badge rounded-pill text-bg-light"><i class="bi bi-shop"></i> @User.Sede()</span>
                    }
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-light dropdown-toggle" data-bs-toggle="dropdown"><i class="bi bi-person-circle"></i> @User.Identity?.Name</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Acceso" asp-action="MiClave"><i class="bi bi-key"></i> Cambiar mi contraseña</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Acceso" asp-action="Salir" method="post">
                                    <button class="dropdown-item"><i class="bi bi-box-arrow-right"></i> Salir</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    @Html.AntiForgeryToken()
    <main class="container-fluid py-4 px-md-4">
        <div class="workspace-label"><i class="bi bi-grid-1x2"></i><span>@cfg.NombreNegocio</span><i class="bi bi-chevron-right"></i><span>@(ViewData["Title"] ?? "Inicio")</span></div>
        @if (ViewData["Title"] != null && ViewData["OcultarTitulo"] == null) { <h4 class="mb-3 titulo-pagina">@ViewData["Title"]</h4> }
        @RenderBody()
    </main>

    <footer class="app-footer">@cfg.NombreNegocio · Ventas, inventario y caja</footer>
    <div class="toast-container position-fixed top-0 end-0 p-3" id="contenedorAlertas"></div>

    <script>window.APP = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        mostrarCocina=cfg.MostrarCocina, mostrarDomicilios=cfg.MostrarDomicilios,
        moneda = cfg.SimboloMoneda, esAdmin, esDomiciliario, negocio = cfg.NombreNegocio, telefonoNegocio = cfg.Telefono, costoDomicilio = cfg.CostoDomicilio,
        minutosEdicion = cfg.MinutosEdicion, minutosAlertaCocina = cfg.MinutosAlertaCocina, minutosAlertaDomicilio = cfg.MinutosAlertaDomicilio }));</script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
