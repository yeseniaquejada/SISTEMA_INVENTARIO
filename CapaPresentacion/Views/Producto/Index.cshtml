@{
    ViewData["Title"] = "Productos del menú";
}
<partial name="_Barra" />
<div class="card"><div class="card-body p-0 table-responsive">
    <table class="table table-hover mb-0" id="tabla">
        <thead class="table-light"><tr><th>Producto</th><th class="text-end">Precio</th><th class="text-center">Insumos en receta</th><th>Estado</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
</div></div>

<div class="modal fade" id="modal" tabindex="-1">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title"></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <form id="formulario" class="row g-3">
                <input type="hidden" name="idProducto" data-tipo="numero" />
                <div class="col-md-7"><label class="form-label">Nombre</label><input name="nombre" class="form-control" maxlength="100" required /></div>
                <div class="col-md-3"><label class="form-label">Precio de venta</label><input name="precio" type="number" min="1" step="0.01" class="form-control" data-tipo="numero" required /></div>
                <div class="col-md-2 d-flex align-items-end"><div class="form-check"><input type="checkbox" name="activo" class="form-check-input" id="chkActivo" /><label class="form-check-label" for="chkActivo">Activo</label></div></div>
            </form>
            <hr />
            <h6>Receta <small class="text-muted">(insumos que se descuentan por cada unidad vendida)</small></h6>
            <div class="row g-2 mb-2">
                <div class="col-md-7"><select id="cboInsumo" class="form-select"></select></div>
                <div class="col-md-3"><input id="txtCantidad" type="number" min="0.001" step="0.001" class="form-control" placeholder="Cantidad" /></div>
                <div class="col-md-2"><button type="button" class="btn btn-outline-danger w-100" id="btnAgregar"><i class="bi bi-plus"></i> Agregar</button></div>
            </div>
            <table class="table table-sm">
                <thead><tr><th>Insumo</th><th class="text-end">Cantidad</th><th></th></tr></thead>
                <tbody id="tablaReceta"></tbody>
            </table>
        </div>
        <partial name="_ModalPie" />
    </div></div>
</div>

@section Scripts {
    <script src="~/js/producto.js" asp-append-version="true"></script>
}
