@{
    ViewData["Title"] = "Insumos";
}
@* Yesenia Quejada Rojas - Claude — 19/10/2026: sin categorías ni PDF; los botones de Excel dicen claramente qué hacen
   y se explica en una línea para qué sirve cada pantalla del inventario. *@
<div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
    <button class="btn btn-marca" id="btnNuevo"><i class="bi bi-plus-lg"></i> Nuevo insumo</button>
    <div class="vr d-none d-md-block mx-1"></div>
    @* Yesenia Quejada Rojas - Claude — 13/11/2026: se quitan los botones de la plantilla de Excel (descargar y subir); queda solo descargar el inventario. *@
    <a href="/Insumo/Exportar" class="btn btn-outline-secondary" title="Descargar en Excel el inventario como está hoy"><i class="bi bi-file-earmark-spreadsheet"></i> Descargar inventario actual</a>
    <input type="search" id="buscar" class="form-control ms-auto" style="max-width:260px" placeholder="Buscar insumo..." aria-label="Buscar insumo" />
</div>
<div class="alert alert-info py-2 small mb-3">
    <div><i class="bi bi-info-circle"></i> <b>Insumos</b> es la lista de lo que compra (pan, carne, gaseosas...) y cuánto hay. La cantidad baja sola con cada venta.</div>
    <div class="mt-1">Cuando llegue una compra o algo se dañe, regístrelo en <a asp-controller="Movimiento" asp-action="Index">Registrar compras y salidas</a> (o con el botón <i class="bi bi-arrow-left-right"></i> de cada fila).
        Si contó el local y la cantidad no coincide, use <a asp-controller="Conteo" asp-action="Index">Contar inventario</a>.</div>
</div>

@* Yesenia Quejada Rojas - Claude — 13/11/2026: se quitan las advertencias de "dato por confirmar" (aviso, nota en cada fila y asterisco de costo estimado). *@
<div class="card"><div class="card-body p-0 table-responsive">
    <table class="table table-hover mb-0 tabla-compacta" id="tabla">
        <thead class="table-light"><tr><th>Insumo</th><th class="text-end">Hay</th><th class="text-end">Avisar con</th><th class="text-end">Costo unit.</th><th>Próximo vencimiento</th><th>Estado</th><th></th><th></th></tr></thead>
        <tbody></tbody>
    </table>
</div></div>

<div class="modal fade" id="modal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title"></h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
        <div class="modal-body">
            <form id="formulario" class="row g-3">
                <input type="hidden" name="idInsumo" data-tipo="numero" />
                <div class="col-12"><label class="form-label" for="txtNombreInsumo">Nombre</label><input id="txtNombreInsumo" name="nombre" class="form-control" maxlength="100" required placeholder="Ej: Pan de hamburguesa" /></div>
                @* Yesenia Quejada Rojas - Claude — 28/10/2026: la categoría vuelve al formulario; con ella se agrupa la hoja de conteo. *@
                <div class="col-md-6"><label class="form-label" for="cboCategoria">Categoría</label><select id="cboCategoria" name="idCategoria" class="form-select" data-tipo="numero"></select></div>
                <div class="col-md-6"><label class="form-label" for="cboUnidad">¿Cómo se cuenta?</label>
                    <select id="cboUnidad" name="unidadMedida" class="form-select">
                        <option value="UND">Unidad (UND)</option><option value="PORC">Porción (PORC)</option><option value="KG">Kilogramo (KG)</option><option value="GR">Gramo (GR)</option>
                        <option value="LT">Litro (LT)</option><option value="ML">Mililitro (ML)</option><option value="PAQ">Paquete (PAQ)</option>
                    </select></div>
                @* Yesenia Quejada Rojas - Claude — 28/10/2026: lo que se compra en paquete (servilletas, tortillas, bolsas) dice cuántas unidades trae;
                   así el costo por unidad sale solo y las recetas descuentan la parte del paquete que usan. *@
                <div class="col-md-6" id="grupoPaquete" hidden><label class="form-label" for="txtUnidadesPaquete">Unidades que trae el paquete</label>
                    <input id="txtUnidadesPaquete" name="unidadesPorPaquete" type="number" min="2" step="1" class="form-control" data-tipo="numero" placeholder="Ej: 100" /></div>
                <div class="col-md-6"><label class="form-label" for="txtCodigo">Código <small class="text-muted">(opcional)</small></label><input id="txtCodigo" name="codigo" class="form-control text-uppercase" maxlength="30" placeholder="Se crea solo" /></div>
                <div class="col-md-6"><label class="form-label" for="txtMinimo">Avisar cuando queden</label><input id="txtMinimo" name="stockMinimo" type="number" min="0" step="0.001" class="form-control" data-tipo="numero" required />
                    <div class="form-text">Cantidad para avisar que hay que comprar.</div></div>
                <div class="col-md-6"><label class="form-label" for="txtCosto" id="lblCosto">Costo por unidad</label><input data-moneda id="txtCosto" name="costoUnitario" type="number" min="0" step="0.01" class="form-control" data-tipo="numero" required />
                    <div class="form-text" id="ayudaCosto"></div></div>
                @* Yesenia Quejada Rojas - Claude — 30/10/2026: en paquetes se ven los dos costos; al escribir uno se calcula el otro. *@
                <div class="col-md-6" id="grupoCostoUnidad" hidden><label class="form-label" for="txtCostoUnidad">Costo por unidad</label><input data-moneda id="txtCostoUnidad" type="number" min="0" step="0.01" class="form-control" />
                    <div class="form-text">Costo del paquete ÷ unidades que trae.</div></div>
                @* Yesenia Quejada Rojas - Claude — 13/11/2026: ya no se escribe el "dato por confirmar". Va oculto para que al guardar
                   no se borre la nota que ya tenía el insumo (quedan en la base para revisarlas con calma). *@
                <input type="hidden" id="txtPorConfirmar" name="porConfirmar" />
                <div class="col-12 form-check ms-2"><input type="checkbox" name="activo" class="form-check-input" id="chkActivo" /><label class="form-check-label" for="chkActivo">Activo</label></div>
                @* Yesenia Quejada Rojas - Claude — 28/10/2026: lo que no se controla (porciones preparadas) no se descuenta al vender ni bloquea la venta. *@
                <div class="col-12 form-check ms-2"><input type="checkbox" name="controlaStock" class="form-check-input" id="chkControla" /><label class="form-check-label" for="chkControla">Descontar al vender <small class="text-muted">(desmarque para porciones preparadas que no se cuentan)</small></label></div>
                <div class="col-12 small text-muted">La cantidad que hay no se escribe aquí: sube con las compras y baja con las ventas.</div>
            </form>
        </div>
        <partial name="_ModalPie" />
    </div></div>
</div>

@section Scripts {
<script>
    (function () {
        const mant = Mantenimiento({
            base: '/Insumo', id: 'idInsumo', columnas: 8,
            nuevo: () => ({ idInsumo: 0, idCategoria: 0, unidadMedida: 'UND', stockMinimo: 0, costoUnitario: 0, activo: true, controlaStock: true, porConfirmar: '' }),
            alAbrir: obj => { original = obj ?? null; },
            fila: i => `<td><div class="fw-semibold">${esc(i.nombre)}</div><small class="text-muted">${esc(i.categoria)} · ${esc(i.codigo)}</small></td>
                <td class="text-end text-nowrap ${i.stock <= i.stockMinimo ? 'stock-bajo' : ''}">${num(i.stock)} ${esc(i.unidadMedida)}${i.unidadesPorPaquete ? `<div class="small text-muted">de ${num(i.unidadesPorPaquete)} und.</div>` : ''}</td>
                <td class="text-end text-nowrap">${num(i.stockMinimo)}</td><td class="text-end text-nowrap">${i.unidadMedida === 'PAQ' && i.unidadesPorPaquete > 1 ? `${moneda(i.costoUnitario)} <small class="text-muted">paq.</small><div class="small text-muted">${moneda(i.costoUnitario / i.unidadesPorPaquete)} c/u</div>` : moneda(i.costoUnitario)}</td>
                <td>${i.proximoVencimiento ? esc(i.proximoVencimiento) : '<span class="text-muted">-</span>'}</td>
                <td>${badgeActivo(i.activo)}${i.controlaStock ? '' : ' <span class="badge text-bg-secondary" title="No se descuenta al vender">Sin control</span>'}</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/Movimiento?idInsumo=${i.idInsumo}" title="Registrar compra, salida o daño de ${esc(i.nombre)}"><i class="bi bi-arrow-left-right"></i></a></td>`
        });

        // Yesenia Quejada Rojas - Claude — 28/10/2026: con unidad Paquete se pide cuántas trae y se muestra el costo de cada unidad.
        const cboUnidad = document.getElementById('cboUnidad'), txtCosto = document.getElementById('txtCosto'), txtUnidades = document.getElementById('txtUnidadesPaquete');
        function pintarPaquete() {
            const paq = cboUnidad.value === 'PAQ';
            document.getElementById('grupoPaquete').hidden = !paq;
            txtUnidades.required = paq;
            document.getElementById('lblCosto').textContent = paq ? 'Costo del paquete' : 'Costo por unidad';
            const n = Number(txtUnidades.value), c = Number(txtCosto.value);
            const ayuda = [];
            document.getElementById('grupoCostoUnidad').hidden = !paq;
            if (paq && n > 1 && document.activeElement !== txtCostoUnidad) txtCostoUnidad.value = c > 0 ? Math.round(c / n * 100) / 100 : '';
            /* Yesenia Quejada Rojas - Claude — 29/10/2026. Al pasar a paquete se avisa qué pasa con el stock y las recetas (las convierte el SP),
               y si el tamaño obliga a redondear lo que descuenta cada unidad (la base guarda 3 decimales). */
            if (paq && n > 1 && original && (original.unidadMedida !== 'PAQ' || original.unidadesPorPaquete !== n)) {
                ayuda.push(`Las recetas se convierten solas. Lo que hay (${num(original.stock)}) se toma en paquetes.`);
                const parte = Math.max(0.001, Math.round(1000 / n) / 1000), error = Math.abs(parte * n - 1);
                if (error > 0.01) ayuda.push(`Ojo: cada unidad descontará ${num(parte)} paquete (redondeo de ${Math.round(error * 100)} %).`);
            }
            document.getElementById('ayudaCosto').textContent = ayuda.join(' ');
        }
        // Yesenia Quejada Rojas - Claude — 29/10/2026: si el insumo estaba por unidad, al poner cuántas trae el paquete
        // el costo del paquete se calcula con el costo por unidad que tenía (se puede corregir). Se borra la nota de paquete pendiente.
        const NOTA_PAQUETE = 'Falta saber cuántas unidades trae el paquete';
        let original = null;
        function calcularCostoPaquete() {
            const n = Number(txtUnidades.value);
            if (cboUnidad.value !== 'PAQ' || !original || original.unidadMedida === 'PAQ' || !(n > 1)) return;
            txtCosto.value = Math.round(original.costoUnitario * n * 100) / 100;
            const nota = document.getElementById('txtPorConfirmar');
            if (nota.value.trim() === NOTA_PAQUETE) nota.value = '';
        }
        [cboUnidad, txtUnidades].forEach(el => el.addEventListener('input', calcularCostoPaquete));
        const txtCostoUnidad = document.getElementById('txtCostoUnidad');
        txtCostoUnidad.addEventListener('input', () => {
            const n = Number(txtUnidades.value);
            if (n > 1 && txtCostoUnidad.value !== '') { txtCosto.value = Math.round(Number(txtCostoUnidad.value) * n * 100) / 100; pintarPaquete(); }
        });
        [cboUnidad, txtCosto, txtUnidades].forEach(el => el.addEventListener('input', pintarPaquete));
        document.getElementById('modal').addEventListener('show.bs.modal', pintarPaquete);

        api.get('/Categoria/Listar').then(c => llenarSelect(document.getElementById('cboCategoria'), c.filter(x => x.activo), 'idCategoria', 'descripcion', 'Seleccione...')).catch(errorAlerta);
    })();
</script>
}
