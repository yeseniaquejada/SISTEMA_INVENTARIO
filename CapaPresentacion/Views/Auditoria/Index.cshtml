@{ ViewData["Title"]="Auditoría y verificación"; }
<div class="card shadow-sm mb-3"><div class="card-body">
 <div class="d-flex flex-wrap justify-content-between gap-2"><div><h5>Consistencia del inventario</h5><p class="text-muted mb-0">Compara stock, lotes disponibles y saldo neto del kardex. No modifica cantidades.</p></div><button id="btnVerificar" class="btn btn-outline-marca">Verificar ahora</button></div>
 <div id="resultadoInventario" class="mt-3" role="status"></div>
</div></div>
<div class="card shadow-sm"><div class="card-body">
 <h5>Historial de cambios</h5><p class="small text-muted">Registro desde la actualización V4: caja, gastos, ventas, inventario, recetas, productos, modificadores, usuarios, sedes y configuración. Incluye cambios SQL; no guarda contraseñas. Se muestran los últimos 500 cambios del período para esta sede y los cambios globales.</p>
 <form id="filtroAuditoria" class="d-flex flex-wrap gap-2 mb-3"><label>Desde <input type="date" id="inicio" class="form-control" required /></label><label>Hasta <input type="date" id="fin" class="form-control" required /></label><button class="btn btn-marca align-self-end">Consultar</button></form>
 <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Fecha</th><th>Usuario</th><th>Registro</th><th>Acción</th><th>Cambios</th></tr></thead><tbody id="tablaAuditoria"></tbody></table></div>
</div></div>
@section Scripts {<script>
(()=>{
 const $=id=>document.getElementById(id); $('inicio').value=$('fin').value=hoy();
 const detalle=s=>{try{return JSON.stringify(JSON.parse(s),null,2);}catch{return s;}};
 async function cargar(){try{const q=new URLSearchParams({inicio:$('inicio').value,fin:$('fin').value});const lista=await api.get('/Auditoria/Listar?'+q);renderTabla($('tablaAuditoria'),lista,a=>`<tr><td class="text-nowrap">${esc(a.fecha)}</td><td>${esc(a.usuario)}</td><td>${esc(a.tabla)}</td><td>${esc(a.accion)}</td><td><details><summary>Ver antes y después</summary><strong>Antes</strong><pre class="small" style="max-width:600px;white-space:pre-wrap">${esc(detalle(a.antes))}</pre><strong>Después</strong><pre class="small" style="max-width:600px;white-space:pre-wrap">${esc(detalle(a.despues))}</pre></details></td></tr>`,5);}catch(e){errorAlerta(e);}}
 $('filtroAuditoria').addEventListener('submit',ev=>{ev.preventDefault();if($('inicio').value>$('fin').value)return alerta('Revise las fechas','warning');cargar();});
 $('btnVerificar').addEventListener('click',async()=>{const b=$('btnVerificar');b.disabled=true;try{const lista=await api.get('/Auditoria/VerificarInventario');$('resultadoInventario').innerHTML=lista.length?'<div class="alert alert-warning">Hay diferencias; revise el kardex y realice un conteo físico antes de corregirlas.</div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Insumo</th><th>Stock</th><th>Lotes</th><th>Kardex</th></tr></thead><tbody>'+lista.map(i=>`<tr><td>${esc(i.codigo)} · ${esc(i.nombre)}</td><td>${num(i.stock)}</td><td>${num(i.lotes)}</td><td>${num(i.kardex)}</td></tr>`).join('')+'</tbody></table></div>':'<div class="alert alert-success mb-0">El stock coincide con los lotes y el kardex.</div>';}catch(e){errorAlerta(e);}finally{b.disabled=false;}});
 cargar();
})();
</script>}
